  "6555566397844631314": {
    "targets": {
      "test": {
        "command": "jest",
        "options": {
          "cwd": "apps/admin-ui"
        },
        "metadata": {
          "technologies": [
            "jest"
          ],
          "description": "Run Jest Tests",

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Models

model User {
  id          Int           @id @unique @default(autoincrement())
  name        String?
  phone       String?
  transaction Transaction[]
  mass        Mass[]
  massOrder   MassOrder[]
}

model Mass {
  id               Int         @id @default(autoincrement())
  price            Int?
  processAt        DateTime? // We can use this field wheither as the date and time the user would like the mass process or the one for a specific mass at church.
  intension        String? //  We can use this field only when User created a mass directly from Priest. So that he can leave intension depending on itself.
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  standardPrice    Int         @default(5000)
  massType         MassType    @default(UNIQUE)
  createdByUser    User        @relation(fields: [userId], references: [id])
  createdByParish  Parish      @relation(fields: [parishId], references: [id])
  assignedToPriest Priest      @relation(fields: [priestId], references: [id])
  userId           Int
  parishId         Int
  priestId         Int
  massOrder        MassOrder[]
}

model MassOrder {
  id          Int      @id @default(autoincrement())
  createAt    DateTime @default(now())
  intension   String
  orderByUser User     @relation(fields: [userId], references: [id])
  mass        Mass     @relation(fields: [massId], references: [id])
  userId      Int
  massId      Int
}

model Transaction {
  id            Int      @id @default(autoincrement())
  transactionId String   @unique @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  price         Int
  status        Status
  user          User     @relation(fields: [userId], references: [id])
  initByPriest  Priest   @relation(fields: [priestId], references: [id])
  initByParish  Parish   @relation(fields: [parishId], references: [id])
  userId        Int
  priestId      Int
  parishId      Int
}

model Priest {
  id           Int                  @id @default(autoincrement())
  firstName    String
  secondName   String?
  image        String?
  birthDate    DateTime
  phone        String?
  authNumber   String               @unique
  authCardImge String?
  availability Boolean              @default(false)
  email        String               @unique
  souscribeAt  DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  transaction  Transaction[]
  mass         Mass[]
  notif        NotificationPriest[]
}

model Parish {
  id          Int                  @id @default(autoincrement())
  name        String
  email       String               @unique
  phone       String
  city        String
  region      String
  diocese     String
  leadManager String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  transaction Transaction[]
  mass        Mass[]
  notif       NotificationParish[]
}

model Notification {
  id        Int                  @id @default(autoincrement())
  content   String
  createdAt DateTime             @default(now())
  parish    NotificationParish[]
  priest    NotificationPriest[]
}

model NotificationParish {
  id       Int          @id @default(autoincrement())
  isRead   Boolean      @default(false)
  notif    Notification @relation(fields: [notifId], references: [id])
  parish   Parish       @relation(fields: [parishId], references: [id])
  notifId  Int
  parishId Int
}

model NotificationPriest {
  id       Int          @id @default(autoincrement())
  isRead   Boolean      @default(false)
  notif    Notification @relation(fields: [notifId], references: [id])
  priest   Priest       @relation(fields: [priestId], references: [id])
  notifId  Int
  priestId Int
}

enum MassType {
  UNIQUE
  TRIDUM
  SEVEN
  NOVENA
  THIRTY
}

enum Status {
  VALIDED
  PROCESS
  ECHEC
}

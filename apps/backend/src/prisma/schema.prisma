generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Believer {
  id          String        @id @unique @default(cuid())
  name        String?
  phone       String?
  mass        Mass[]
  massOrder   MassOrder[]
  transaction Transaction[]
}

model Mass {
  id                Int         @id @default(autoincrement())
  price             Int?
  intension         String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  standardPrice     Int         @default(5000)
  massType          MassType    @default(UNIQUE)
  parishId          Int?
  priestId          Int?
  believerId        String?
  processAt         DateTime?
  createdByBeliever Believer?   @relation(fields: [believerId], references: [id])
  createdByParish   Parish?     @relation(fields: [parishId], references: [id])
  assignedToPriest  Priest?     @relation(fields: [priestId], references: [id])
  massOrder         MassOrder[]
}

model MassOrder {
  id              Int      @id @default(autoincrement())
  createAt        DateTime @default(now())
  intension       String
  massId          Int
  believerId      String
  price           Int
  orderByBeliever Believer @relation(fields: [believerId], references: [id])
  mass            Mass     @relation(fields: [massId], references: [id])
}

model Transaction {
  id            Int       @id @default(autoincrement())
  transactionId String    @unique @default(cuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  price         Int
  status        Status
  priestId      Int?
  parishId      Int?
  believerId    String?
  currency      String
  paymentMethod String
  believer      Believer? @relation(fields: [believerId], references: [id])
  initByParish  Parish?   @relation(fields: [parishId], references: [id])
  initByPriest  Priest?   @relation(fields: [priestId], references: [id])
}

model Priest {
  id           Int                  @id @default(autoincrement())
  firstName    String
  secondName   String
  image        String?
  birthDate    String
  phone        String
  authNumber   String               @unique
  authCardImge String?
  availability Boolean              @default(false)
  email        String               @unique
  souscribeAt  DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  password     String
  balance      Int                  @default(0)
  receiverId   String?              @unique
  mass         Mass[]
  notif        NotificationPriest[]
  refleshToken RefreshToken[]
  transaction  Transaction[]
  otp          otp[]
}

model Parish {
  id             Int                  @id @default(autoincrement())
  name           String
  email          String               @unique
  phone          String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  password       String
  adminId        Int
  balance        Int                  @default(0)
  receiverId     String?              @unique
  city_id        String
  manager_name   String
  mass           Mass[]
  notif          NotificationParish[]
  createdByAdmin Administrator        @relation(fields: [adminId], references: [id])
  city           City                 @relation(fields: [city_id], references: [city_id])
  refleshToken   RefreshToken[]
  transaction    Transaction[]
  otp            otp[]
}

model Administrator {
  id           Int            @id @default(autoincrement())
  name         String
  email        String         @unique
  password     String
  phone        String
  role         Role
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  parish       Parish[]
  refleshToken RefreshToken[]
  otp          otp[]
}

model Notification {
  id             Int                  @id @default(autoincrement())
  content        String
  createdAt      DateTime             @default(now())
  notificationId String               @unique
  parish         NotificationParish[]
  priest         NotificationPriest[]
}

model NotificationParish {
  id       Int          @id @default(autoincrement())
  isRead   Boolean      @default(false)
  notifId  Int
  parishId Int
  notif    Notification @relation(fields: [notifId], references: [id])
  parish   Parish       @relation(fields: [parishId], references: [id])
}

model NotificationPriest {
  id       Int          @id @default(autoincrement())
  isRead   Boolean      @default(false)
  notifId  Int
  priestId Int
  notif    Notification @relation(fields: [notifId], references: [id])
  priest   Priest       @relation(fields: [priestId], references: [id])
}

model RefreshToken {
  id           String         @id
  refreshToken String         @unique
  expiredDate  String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  priestId     Int?
  parishId     Int?
  adminId      Int?
  adminToken   Administrator? @relation(fields: [adminId], references: [id])
  parishToken  Parish?        @relation(fields: [parishId], references: [id])
  priestToken  Priest?        @relation(fields: [priestId], references: [id])
}

model City {
  city_id   String   @id @default(cuid())
  city_name String
  country   String   @default("Cameroon")
  parish    Parish[]

  @@unique([city_name, country])
}

model otp {
  otp_id    String         @id @default(cuid())
  code      String
  createdAt DateTime       @default(now())
  expiredAt DateTime
  isUsed    Boolean        @default(false)
  adminId   Int?
  parishId  Int?
  priestId  Int?
  admin     Administrator? @relation(fields: [adminId], references: [id])
  parish    Parish?        @relation(fields: [parishId], references: [id])
  priest    Priest?        @relation(fields: [priestId], references: [id])
}

enum MassType {
  UNIQUE
  TRIDUM
  SEVEN
  NOVENA
  THIRTY
}

enum Status {
  VALIDED
  PROCESS
  ECHEC
  INIT
}

enum Role {
  ENGENEER
  ADMIN
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// OLD SCHEMA VERSION
model MassOrderHasMasses {
  massOrder_has_mass_id String @id @default(cuid())
  mass_id               Int
  massOrder_id          Int
}

model Transaction {
  id            Int      @id @default(autoincrement())
  transactionId String   @unique @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  price         Int
  status        Status
  priestId      Int?
  parishId      Int?
  believerId    String?
  currency      String
  paymentMethod String
}

enum MassType {
  UNIQUE @map("unique")
  TRIDUM @map("tridum")
  SEVEN  @map("seven")
  NOVENA @map("novena")
  THIRTY @map("thirty")

  @@map("mass_type")
}

enum Status {
  VALIDED
  PROCESS
  ECHEC
  INIT
}

// NEW SCHEMA VERSION

model User {
  user_id                    String            @id @default(cuid()) @db.VarChar(36)
  first_name                 String?           @db.VarChar(45) // Main name uses by all user (believer/parish/admin/priest)
  last_name                  String?           @db.VarChar(45)
  email                      String            @unique @db.VarChar(100)
  password                   String?           @db.VarChar(255)
  phone_number               String?           @db.VarChar(45)
  is_account_verified        Boolean?          @db.Boolean // Has been verified by email
  birthdate                  DateTime?         @db.Date
  created_at                 DateTime          @default(now()) @db.Timestamp
  prefered_language          PreferredLanguage @default(EN_US)
  is_active                  Boolean           @default(true) @db.Boolean // Identify all user which can use the platform or deleted
  notify_mass_recommendation Boolean?          @default(true) @db.Boolean
  notify_on_platform_updates Boolean?          @default(true) @db.Boolean
  manager_name               String?           @db.VarChar(45)
  deleted_at                 DateTime?         @db.Timestamp
  balance                    Float?
  profile_ref                String?           @db.VarChar(255)
  address                    String?           @db.VarChar(90)
  role                       Role
  created_by                 String?           @db.VarChar(36)
  CreatedBy                  User?             @relation("userTouser", fields: [created_by], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_User_User1")
  User                       User[]            @relation("userTouser")
  OTP                        OTP[]
  Log                        Log[]
  Mass                       Mass[]            @relation("massTouser")
  MassAssigned               Mass[]            @relation("massToAssignedUser")
  UserRequestMass            UserRequestMass[]

  @@index([created_by], map: "fk_User_User1_idx")
  @@map("users")
}

model OTP {
  otp_id      String   @id @default(cuid()) @db.VarChar(36)
  code        String   @db.VarChar(6)
  created_at  DateTime @default(now()) @db.Timestamp()
  expired_at  DateTime @db.Timestamp()
  is_verified Boolean  @default(false) @db.Boolean
  usage       OtpUsage
  updated_at  DateTime @updatedAt @db.Timestamp()
  user_id     String   @db.VarChar(36)
  User        User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_OTP_User1")

  @@index([user_id], map: "fk_OTP_User1_idx")
  @@map("otps")
}

model Mass {
  mass_id           String             @id @default(cuid()) @db.VarChar(36)
  price             Int
  intension         String?            @db.VarChar(200)
  created_at        DateTime           @default(now()) @db.Timestamp()
  updated_at        DateTime           @updatedAt @db.Timestamp()
  proceed_at        DateTime           @db.Timestamp()
  mass_type         MassType           @default(UNIQUE)
  created_by        String             @db.VarChar(36)
  assigned_to       String?            @db.VarChar(36)
  mass_valided_type MassValidadedType?
  CreatedBy         User               @relation("massTouser", fields: [created_by], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_Mass_User1")
  AssignedTo        User?              @relation("massToAssignedUser", fields: [assigned_to], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_Mass_User2")
  UserRequestMass   UserRequestMass[]

  @@index([created_by], map: "fk_Mass_User1_idx")
  @@index([assigned_to], map: "fk_Mass_User2_idx")
  @@map("masses")
}

model UserRequestMass {
  user_request_mass_id String   @id @default(cuid()) @db.VarChar(36)
  intension            String   @db.VarChar(200)
  requested_amount     Int // Amount of mass requested by user uclinding all taxes
  user_id              String   @db.VarChar(36)
  mass_id              String   @db.VarChar(36)
  purchased_at         DateTime @default(now()) @db.Timestamp()
  request_type         MassType @default(UNIQUE)
  User                 User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_UserRequestMass_User1")
  Mass                 Mass     @relation(fields: [mass_id], references: [mass_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_UserRequestMass_Mass1")

  @@index([user_id], map: "fk_UserRequestMass_User1_idx")
  @@index([mass_id], map: "fk_UserRequestMass_Mass1_idx")
  @@map("user_request_masses")
}

model Log {
  log_id    String     @id @default(cuid()) @db.VarChar(36)
  login_at  DateTime   @default(now()) @db.Timestamp()
  logout_at DateTime?  @db.Timestamp()
  method    AuthMethod @default(LOCAL)
  user_id   String     @db.VarChar(36)
  User      User       @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_Log_User1")

  @@index([user_id], map: "fk_Log_User1_idx")
  @@map("logs")
}

enum PreferredLanguage {
  EN_US @map("en-US")
  FR    @map("fr")

  @@map("preferred_language")
}

enum Role {
  ENGENEER @map("engeneer")
  ADMIN    @map("admin")
  PARISH   @map("parish")
  BELIEVER @map("believer")
  PRIEST   @map("priest")

  @@map("roles")
}

enum OtpUsage {
  RESET_PASSWORD       @map("reset_password")
  VERIFY_EMAIL         @map("verify_email")
  VALIDATE_TRANSACTION @map("validate_transaction")

  @@map("otp_usage")
}

enum AuthMethod {
  LOCAL    @map("local")
  GOOGLE   @map("google")
  FACEBOOK @map("facebook")

  @@map("auth_method")
}

enum MassValidadedType {
  VALIDATED @map("validated")
  PENDING   @map("pending")
  CANCEL    @map("cancel")

  @@map("mass_validated_type")
}

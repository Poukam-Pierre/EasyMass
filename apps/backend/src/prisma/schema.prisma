generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Models

model Believer {
  id          String        @id @unique @default(cuid())
  name        String?
  phone       String?
  transaction Transaction[]
  mass        Mass[]
  massOrder   MassOrder[]
}

model Mass {
  id                Int         @id @default(autoincrement())
  price             Int?
  processAt         DateTime? // The date and time the Believer would like the mass processed, or the date for a specific mass at church.
  intension         String? // Only used when a Believer creates a mass directly through a Priest, to leave an intension.
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  standardPrice     Int         @default(5000)
  massType          MassType    @default(UNIQUE)
  createdByBeliever Believer?   @relation(fields: [believerId], references: [id])
  createdByParish   Parish?     @relation(fields: [parishId], references: [id])
  assignedToPriest  Priest?     @relation(fields: [priestId], references: [id])
  believerId        String?
  parishId          Int?
  priestId          Int?
  massOrder         MassOrder[]
}

model MassOrder {
  id              Int      @id @default(autoincrement())
  createAt        DateTime @default(now())
  intension       String
  price           Int
  orderByBeliever Believer @relation(fields: [believerId], references: [id])
  mass            Mass     @relation(fields: [massId], references: [id])
  believerId      String
  massId          Int
}

model Transaction {
  id            Int       @id @default(autoincrement())
  transactionId String    @unique @default(cuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  price         Int
  status        Status
  paymentMethod String
  currency      String
  believer      Believer? @relation(fields: [believerId], references: [id])
  initByPriest  Priest?   @relation(fields: [priestId], references: [id])
  initByParish  Parish?   @relation(fields: [parishId], references: [id])
  believerId    String?
  priestId      Int?
  parishId      Int?
}

model Priest {
  id            Int                  @id @default(autoincrement())
  firstName     String
  secondName    String
  image         String?
  birthDate     String
  balance       Int                  @default(0)
  phone         String
  authNumber    String               @unique
  authCardImge  String?
  availability  Boolean              @default(false)
  email         String               @unique
  password      String
  souscribeAt   DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  receiverId    String?              @unique
  transaction   Transaction[]
  mass          Mass[]
  notif         NotificationPriest[]
  refreshTokens RefreshToken[]
}

model Parish {
  id             Int                  @id @default(autoincrement())
  name           String
  email          String               @unique
  password       String
  phone          String
  manager_name   String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  balance        Int                  @default(0)
  receiverId     String?              @unique
  transaction    Transaction[]
  mass           Mass[]
  notif          NotificationParish[]
  refreshTokens  RefreshToken[]
  createdByAdmin Administrator        @relation(fields: [adminId], references: [id])
  adminId        Int
  city           City?                @relation(fields: [city_id], references: [city_id])
  city_id        String
}

model Administrator {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  password      String
  phone         String
  role          Role
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  parish        Parish[]
  refreshTokens RefreshToken[]
}

model Notification {
  id             Int                  @id @default(autoincrement())
  notificationId String               @unique
  content        String
  createdAt      DateTime             @default(now())
  parish         NotificationParish[]
  priest         NotificationPriest[]
}

model NotificationParish {
  id       Int          @id @default(autoincrement())
  isRead   Boolean      @default(false)
  notif    Notification @relation(fields: [notifId], references: [id])
  parish   Parish       @relation(fields: [parishId], references: [id])
  notifId  Int
  parishId Int
}

model NotificationPriest {
  id       Int          @id @default(autoincrement())
  isRead   Boolean      @default(false)
  notif    Notification @relation(fields: [notifId], references: [id])
  priest   Priest       @relation(fields: [priestId], references: [id])
  notifId  Int
  priestId Int
}

model RefreshToken {
  id           String         @id
  refreshToken String         @unique
  expiredDate  String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  priestToken  Priest?        @relation(fields: [priestId], references: [id])
  parishToken  Parish?        @relation(fields: [parishId], references: [id])
  adminToken   Administrator? @relation(fields: [adminId], references: [id])
  priestId     Int?
  parishId     Int?
  adminId      Int?
}

model City {
  city_id   String   @id @default(cuid())
  city_name String
  country   String   @unique @default("Cameroon")
  parish    Parish[]

  @@unique([city_name, country])
}

enum MassType {
  UNIQUE
  TRIDUM
  SEVEN
  NOVENA
  THIRTY
}

enum Status {
  VALIDED
  PROCESS
  ECHEC
  INIT
}

enum Role {
  ENGENEER
  ADMIN
}

{
  "name": "diocese-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/diocese-ui",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project diocese-ui --web",
  "targets": {
    "build":{
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/diocese-ui"
      },
      "configurations": {
        "development":{
          "outputPath": "apps/diocese-ui"
        },
        "production": {}
      }
    },
    "serve":{
      "executor": "@nx/next:server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "diocese-ui:build",
        "dev": true
      },
      "configurations": {
        "development":{
          "buildTarget": "diocese-ui:build:development",
          "dev": true
        },
        "production": {
          "buildTarget": "diocese-ui:build:production",
          "dev": false
        }
      }
    },
    "export":{
      "executor": "@nx/next:export",
      "options": {
        "buildTarget":"diocese-ui:build:production"
      }
    },
    "test":{
      "executor": "@nx/next:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig":"apps/diocèse-ui/jest.config.ts"
      }
    },
    "lint":{
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    }
  } ,
  "tagd": []
}

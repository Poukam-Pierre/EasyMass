{
  "name": "parish",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/parish",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project parish --web",
  "targets": {
    "build":{
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/parish"
      },
      "configurations": {
        "development":{
          "outputPath": "apps/parish"
        },
        "production": {}
      }
    },
    "serve":{
      "executor": "@nx/next:server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "parish:build",
        "dev": true,
        "port": 4400
      },
      "configurations": {
        "development":{
          "buildTarget": "parish:build:development",
          "dev": true
        },
        "production": {
          "buildTarget": "parish:build:production",
          "dev": false
        }
      }
    },
    "export":{
      "executor": "@nx/next:export",
      "options": {
        "buildTarget":"parish:build:production"
      }
    },
    "test":{
      "executor": "@nx/next:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig":"apps/parish/jest.config.ts"
      }
    },
    "lint":{
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    }
  },
  "tags": []
}

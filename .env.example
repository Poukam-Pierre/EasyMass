# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Database (Prisma) ---
DATABASE_URL="postgresql://user:password@host:5432/easyMass?schema=public"

# --- Backend server ---
PORT=5000
JWT_SECRET_KEY="replace-with-a-long-random-secret"

# --- NotchPay (mobile money checkout) ---
NOTCH_PUBLIC_KEY=

# --- PayPal (Orders API, checkout + webhook verification) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# --- Checkout redirect targets ---
# Required — initiateNotchPayCheckout throws if unset. Where the payer lands
# in the frontend after completing/cancelling a mobile-money checkout.
FRONTEND_CHECKOUT_RETURN_URL="http://localhost:4200/checkout-return"
# Public base URL of this backend (used to build absolute links, e.g. in
# outbound SMS/email receipts).
APP_PUBLIC_URL="http://localhost:5000"

# --- Orange SMS (mobile money invoice delivery) ---
# All three required — send() silently no-ops (logs and returns) if unset,
# so a missing var here means mobile-money payers never receive their
# invoice SMS with no visible error anywhere else.
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_SENDER_NUMBER=
# Optional.
ORANGE_SENDER_NAME=EasyMesse

# --- SMTP (PayPal invoice delivery) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EasyMesse <no-reply@easymesse.app>"

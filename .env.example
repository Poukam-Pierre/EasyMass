# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Database (Prisma) ---
# If host is a Neon pooled endpoint (contains "-pooler"), append PgBouncer-
# compatible params so Prisma's own pool cooperates with it instead of
# stacking a second, larger pool on top — otherwise a brief Neon compute
# wake-up can cascade into "Timed out fetching a new connection" once
# requests queue up behind the default 25-connection/10s-timeout pool:
# ?sslmode=require&pgbouncer=true&connection_limit=10&pool_timeout=20&connect_timeout=15
# Via docker compose: this is used by host-side tooling (nx serve, prisma
# CLI/seed) and by the `postgres` service itself. The `backend` container
# always connects via the `postgres` service name instead — see compose.yml.
DATABASE_URL="postgresql://user:password@localhost:5432/easyMass?schema=public"
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Backend server ---
PORT=5000
# IANA zone for dates shown in emails/PDFs (server runs in UTC). Default: Africa/Douala
DISPLAY_TIME_ZONE=
JWT_SECRET_KEY="replace-with-a-long-random-secret"

# --- Account setup emails ---
# Public URL of the parish app — new parish accounts are emailed a link to
# <PARISH_APP_URL>/account-setup?token=… to verify their email and choose
# their password. Production: https://parish.easymesse.com
PARISH_APP_URL="http://localhost:4400"

# --- CORS ---
# Comma-separated list of allowed origins. Dev default (easy-messe/admin-ui/
# parish on localhost) applies when unset — only needed for production:
# CORS_ORIGINS="https://easymesse.com,https://admin.easymesse.com,https://parish.easymesse.com"
CORS_ORIGINS=

# --- Frontend API base URL ---
# Baked into the Next.js client bundle at build time (NEXT_PUBLIC_*), shared
# by easy-messe/admin-ui/parish — see compose.yml build args. Must include
# the `/api` global prefix. Production: https://api.easymesse.com/api
NEXT_PUBLIC_API_URL="http://localhost:5000/api"

# --- NotchPay (mobile money checkout) ---
NOTCH_PUBLIC_KEY=

# --- PayPal (Orders API, checkout + webhook verification) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# --- Checkout redirect targets ---
# Required — initiateNotchPayCheckout throws if unset. Where the payer lands
# in the frontend after completing/cancelling a mobile-money checkout.
# Production: https://easymesse.com/checkout-return
FRONTEND_CHECKOUT_RETURN_URL="http://localhost:4200/checkout-return"
# Public base URL of this backend (used to build absolute links, e.g. in
# outbound SMS/email receipts). Production: https://api.easymesse.com
APP_PUBLIC_URL="http://localhost:5000"

# --- Orange SMS (mobile money invoice delivery) ---
# All three required — send() silently no-ops (logs and returns) if unset,
# so a missing var here means mobile-money payers never receive their
# invoice SMS with no visible error anywhere else.
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
COUNTRY_SENDER_NUMBER=
# Optional.
ORANGE_SENDER_NAME=EasyMesse

# --- SMTP (PayPal invoice delivery) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EasyMesse <no-reply@easymesse.com>"
